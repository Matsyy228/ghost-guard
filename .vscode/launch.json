{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug backend",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.server",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONDONTWRITEBYTECODE": "1", "PYTHONUTF8": "1" }
    },
    {
      "name": "Debug frontend (Edge)",
      "type": "msedge",
      "request": "launch",
      "preLaunchTask": "Start frontend",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "userDataDir": "${workspaceFolder}/.runtime/edge-debug"
    }
  ],
  "compounds": [
    {
      "name": "Debug app (frontend + backend)",
      "configurations": ["Debug backend", "Debug frontend (Edge)"],
      "stopAll": true
    }
  ]
}
