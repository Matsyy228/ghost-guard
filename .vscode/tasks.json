{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start backend",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-B", "-u", "-m", "backend.server"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "workflow" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "ghost-backend",
        "pattern": { "regexp": "^(.+):(\\d+): (.+)$", "file": 1, "line": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting GHOST//GUARD",
          "endsPattern": "^GHOST//GUARD backend ready at http://127\\.0\\.0\\.1:8000 build=[a-f0-9]{16}$"
        }
      }
    },
    {
      "label": "Verify backend build",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-B", "-m", "backend.version", "--check"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Start frontend",
      "dependsOn": "Verify backend build",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-B", "-u", "-m", "http.server", "5173", "--bind", "127.0.0.1", "--directory", "frontend"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "workflow" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "python-http-server",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^\\s*File \"(.+)\", line (\\d+)(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving HTTP on ",
          "endsPattern": "^Serving HTTP on 127\\.0\\.0\\.1 port 5173 "
        }
      }
    },
    {
      "label": "Start app (frontend + backend)",
      "dependsOrder": "sequence",
      "dependsOn": ["Start backend", "Start frontend"],
      "problemMatcher": []
    }
  ]
}
